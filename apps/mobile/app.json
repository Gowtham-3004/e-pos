{
  "expo": {
    "name": "Elixir POS",
    "slug": "elixir-pos-mobile",
    "scheme": "elixirpos",
    "version": "1.4.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f4f6f9",
    "ios": {
      "bundleIdentifier": "com.elixir.posmobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.elixir.posmobile",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Elixir POS Mobile",
      "themeColor": "#111c30",
      "backgroundColor": "#f4f6f9"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
